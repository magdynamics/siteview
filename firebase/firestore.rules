rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }
    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return isAuth() && getUser().role == role;
    }
    // Roles that should see company-wide field data (pay rates, timesheets,
    // documents) rather than only their own records
    function isOfficeRole() {
      return isAuth() && getUser().role in ['admin', 'manager', 'supervisor', 'accountant'];
    }

    // User docs carry pay rates and FCM tokens: employees may read only
    // their own profile; office roles may read the directory
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        getUser().role in ['admin', 'manager', 'supervisor', 'accountant']
      );
      allow write: if hasRole('admin');
    }
    match /sites/{siteId} {
      allow read: if isAuth();
      allow write: if hasRole('admin');
    }
    match /punches/{punchId} {
      // Punches carry a rateSnapshot (pay rate at punch-in) — only the
      // employee who owns the punch or office roles may read it
      allow read: if isAuth() && (
        resource.data.employeeId == request.auth.uid || isOfficeRole()
      );
      allow create: if isAuth();
      allow update: if hasRole('admin') || hasRole('supervisor');
    }
    match /timesheets/{timesheetId} {
      allow read: if isAuth() && (
        resource.data.employeeId == request.auth.uid || isOfficeRole()
      );
      allow write: if hasRole('admin') || hasRole('supervisor') || hasRole('accountant');
    }
    match /task_photos/{photoId} {
      allow read: if isAuth();
      allow create: if isAuth();
    }
    match /documents/{docId} {
      allow read: if isAuth() && (
        resource.data.uploadedBy == request.auth.uid || isOfficeRole()
      );
      allow create: if isAuth();
    }
    match /audit_logs/{logId} {
      allow read: if hasRole('admin') || hasRole('supervisor') || hasRole('accountant') || hasRole('manager');
      allow create: if isAuth();
      allow update, delete: if false; // Audit logs are immutable
    }

    // Server-only collections — accessed exclusively through the backend
    // Admin SDK (which bypasses these rules). No client rules are defined
    // for them on purpose; rules v2 denies unmatched paths by default:
    //   equipment, maintenance_records, maintenance_schedules, repair_tickets,
    //   inspections, machine_hours_log, inventory, inventory_transactions,
    //   reorder_requests, notifications, system
  }
}
